# OpenAI API Key. Also set a monthly budget cap in the OpenAI dashboard.
OPENAI_API_KEY=your_openai_api_key

# Public chat gate. This value is visible in the browser and is not authentication.
# Spend is capped in the app by the limits below.
NEXT_PUBLIC_API_KEY=your_public_api_key

# Database
TURSO_DB_URL=your_turso_database_url
TURSO_DB_AUTH_TOKEN=your_turso_auth_token

# Enquiry email. The from-address domain must be verified in Resend.
RESEND_API_KEY=your_resend_api_key

# Segment that receives /events registrations. This is the LTEY AI segment.
RESEND_LTEY_SEGMENT_ID=16a70ff2-04d9-4453-8221-2fef6a5254be

# reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Vercel Cron sends this as Authorization: Bearer <CRON_SECRET> to /api/chat/cleanup.
CRON_SECRET=your_cron_secret

# Analytics. Loaded only after the visitor allows it. Must look like GTM-XXXX.
NEXT_PUBLIC_GTM_ID=GTM-XXXX

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chat spend caps. Defaults apply when these are unset.
# 12 messages per IP per 10 minutes, 40 per IP per UTC day, 500 across the site per UTC day.
CHAT_IP_LIMIT=12
CHAT_IP_WINDOW_MS=600000
CHAT_IP_DAILY_LIMIT=40
CHAT_DAILY_LIMIT=500

# Enquiry caps. 5 per IP per hour, 40 across the site per UTC day.
CONTACT_IP_LIMIT=5
CONTACT_IP_WINDOW_MS=3600000
CONTACT_DAILY_LIMIT=40

# /events registrations. Separate from enquiries. 3 per email per hour,
# 120 per IP per hour (a venue often shares one connection), 1000 per UTC day.
EVENT_EMAIL_LIMIT=3
EVENT_EMAIL_WINDOW_MS=3600000
EVENT_IP_LIMIT=120
EVENT_IP_WINDOW_MS=3600000
EVENT_DAILY_LIMIT=1000

NODE_ENV=development
